{
  "name": "@maks11060/discord-interactions",
  "version": "0.0.0",
  "tasks": {
    "ok": "deno fmt --check && deno publish --dry-run --allow-dirty",
    "init": "git config core.hooksPath .hooks",
    "dev": "deno run -A --env-file --watch-hmr src/serve.ts"
  },
  "imports": {
    "@hono/standard-validator": "npm:@hono/standard-validator@^0.1.5",
    "@std/bytes": "jsr:@std/bytes@^1.0.6",
    "@std/collections": "jsr:@std/collections@^1.1.3",
    "@std/encoding": "jsr:@std/encoding@^1.0.10",
    "discord-api-types": "npm:discord-api-types@^0.38.21",
    "hono": "npm:hono@^4.9.4",
    "zod": "npm:zod@^4.1.3"
  },
  "exports": {
    ".": "./mod.ts"
  },
  "fmt": {
    "exclude": [
      ".vite",
      "dist",
      "public",
      "**/*.oas.ts",
      "node_modules"
    ],
    "lineWidth": 120,
    "newLineKind": "system",
    "quoteProps": "asNeeded",
    "semiColons": false,
    "singleQuote": true,
    "spaceSurroundingProperties": false
  },
  "unstable": [
    "fmt-component",
    "kv"
  ]
}
