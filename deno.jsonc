{
  "name": "@maks11060/discord-interactions",
  "version": "0.0.0",
  "tasks": {
    "ok": "deno fmt --check && deno publish --dry-run --allow-dirty",
    "init": "git config core.hooksPath .hooks",
    "dev": "deno run -A --env-file --watch-hmr src/serve.ts",
    "gen:discord": "deno x npm:openapi-typescript https://raw.githubusercontent.com/discord/discord-api-spec/main/specs/openapi.json --make-paths-enum -o src/lib/discord.oas.ts"
  },
  "imports": {
    "@hono/standard-validator": "npm:@hono/standard-validator@^0.2.2",
    "@maks11060/oauth2": "jsr:@maks11060/oauth2@^0.0.2",
    "@std/bytes": "jsr:@std/bytes@^1.0.6",
    "@std/collections": "jsr:@std/collections@^1.1.3",
    "@std/encoding": "jsr:@std/encoding@^1.0.10",
    "discord-api-types": "npm:discord-api-types@^0.38.37",
    "drizzle-kit": "npm:drizzle-kit@^1.0.0-beta.11-05230d9",
    "drizzle-orm": "npm:drizzle-orm@^1.0.0-beta.11-05230d9",
    "hono": "npm:hono@^4.11.4",
    "openapi-fetch": "npm:openapi-fetch@^0.15.0",
    "zod": "npm:zod@^4.3.5",
    // alias
    "#/lib/": "./src/lib/",
    "#/": "./src/"
  },
  "exports": {
    ".": "./src/mod.ts"
  },
  "fmt": {
    "exclude": [
      ".vite",
      "dist",
      "public",
      "**/*.oas.ts",
      "node_modules"
    ],
    "lineWidth": 120,
    "newLineKind": "system",
    "quoteProps": "asNeeded",
    "semiColons": false,
    "singleQuote": true,
    "spaceSurroundingProperties": false
  },
  "compilerOptions": {
    "verbatimModuleSyntax": true
  }
}
