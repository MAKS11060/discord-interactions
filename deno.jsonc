{
  "name": "@maks11060/discord-interactions",
  "version": "0.0.0",
  "lock": false,
  "tasks": {
    "dev": "vite"
  },
  "imports": {
    "@deno/vite-plugin": "npm:@deno/vite-plugin@^1.0.5",
    "@hono/standard-validator": "npm:@hono/standard-validator@^0.1.5",
    "@maks11060/kv": "jsr:@maks11060/kv@^0.1.0",
    "@maks11060/svelte5-router": "npm:@maks11060/svelte5-router@^3.1.1",
    "@std/bytes": "jsr:@std/bytes@^1.0.6",
    "@std/collections": "jsr:@std/collections@^1.1.3",
    "@std/encoding": "jsr:@std/encoding@^1.0.10",
    "@sveltejs/vite-plugin-svelte": "npm:@sveltejs/vite-plugin-svelte@^6.1.3",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.1.12",
    "daisyui": "npm:daisyui@^5.0.51",
    "discord-api-types": "npm:discord-api-types@^0.38.21",
    "hono": "npm:hono@^4.9.4",
    "svelte": "npm:svelte@^5.38.5",
    "tailwindcss": "npm:tailwindcss@^4.1.12",
    "vite": "npm:vite@^7.1.3",
    "zod": "npm:zod@^4.1.3"
  },
  "exports": {
    ".": "./mod.ts"
  },
  "fmt": {
    "exclude": [
      ".vite",
      "dist",
      "public",
      "**/*.oas.ts",
      "node_modules"
    ],
    "lineWidth": 120,
    "newLineKind": "system",
    "quoteProps": "asNeeded",
    "semiColons": false,
    "singleQuote": true,
    "spaceSurroundingProperties": false
  },
  "unstable": [
    "fmt-component",
    "kv"
  ],
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "lib": [
      "dom",
      "deno.ns",
      "deno.unstable",
      "deno.window"
    ]
  }
}
