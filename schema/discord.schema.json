{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "default": "https://raw.githubusercontent.com/MAKS11060/discord-interaction/main/schema/discord.schema.json",
      "type": "string"
    },
    "applications": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "clientId": {
            "type": "string",
            "minLength": 1
          },
          "clientSecret": {
            "type": "string",
            "minLength": 1
          },
          "publicKey": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "schema"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "$schema",
    "applications"
  ],
  "additionalProperties": false
}
