{
  "name": "@maks11060/discord-interactions",
  "version": "0.1.0",
  "description": "TypeScript toolkit and CLI for building Discord interactions, application commands, and message components.",
  "keywords": [
    "discord",
    "discord-api",
    "discord-interactions",
    "slash-commands",
    "message-components",
    "typescript",
    "cli"
  ],
  "license": "MIT",
  "author": "MAKS11060",
  "type": "module",
  "imports": {
    "#adapter/*": "./src/adapter/*",
    "#lib/*": "./src/lib/*",
    "#app": "./src/index.ts",
    "#env": {
      "deno": {
        "types": "./src/lib/env/deno.ts",
        "default": "./src/lib/env/deno.ts"
      },
      "default": {
        "types": "./src/lib/env/node.ts",
        "default": "./src/lib/env/node.ts"
      }
    },
    "#serve": {
      "bun": {
        "types": "./src/lib/serve/bun.ts",
        "default": "./src/lib/serve/bun.ts"
      },
      "deno": {
        "types": "./src/lib/serve/deno.ts",
        "default": "./src/lib/serve/deno.ts"
      },
      "node": {
        "types": "./src/lib/serve/node.ts",
        "default": "./src/lib/serve/node.ts"
      },
      "default": {
        "types": "./src/lib/serve/node.ts",
        "default": "./src/lib/serve/node.ts"
      }
    }
  },
  "exports": {
    ".": "./src/index.ts",
    "./fmt": "./src/fmt.ts",
    "./web": "./src/adapter/web.ts",
    "./hono": "./src/adapter/hono.ts"
  },
  "bin": {
    "discord": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "fmt": "dprint fmt",
    "lint": "dprint check && tsc --noEmit",
    "tc": "tsc --noEmit",
    "tcw": "tsc --noEmit --watch",
    "cli": "node --env-file-if-exists=.env --import tsx ./cli/index.ts",
    "discord": "node --env-file-if-exists=.env --import tsx ./cli/index.ts",
    "generate:discord-schema": "tsx ./scripts/generate-discord-schema.ts",
    "dev": "deno run -A --env-file --watch-hmr --unstable-no-legacy-abort ./example/main.ts",
    "dev:node": "node --env-file-if-exists=.env --watch ./example/main.ts",
    "dev:bun": "bun --hot ./example/main.ts",
    "build": "tsdown",
    "openapi-ts": "openapi-ts",
    "prepare": "git config core.hooksPath .hooks",
    "prepack": "pnpm lint && pnpm build && pnpm transform-publish-config --extension mjs,d.mts --write"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.3",
    "discord-api-types": "^0.38.56",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.0.0-next-20260930190945",
    "@hono/node-server": "^2.1.5",
    "@maks11060/oauth2": "jsr:^0.0.2",
    "@maks11060/transform-publish-config": "^0.0.1",
    "@types/bun": "catalog:",
    "@types/deno": "catalog:",
    "@types/node": "catalog:",
    "tsdown": "^0.23.1",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "hono": "catalog:"
  },
  "packageManager": "pnpm@12.11.2",
  "publishConfig": {
    "imports": {
      "#adapter/*": {
        "types": "./dist/adapter/*.d.mts",
        "default": "./dist/adapter/*.mjs"
      },
      "#lib/*": {
        "types": "./dist/lib/*.d.mts",
        "default": "./dist/lib/*.mjs"
      },
      "#app": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "#env": {},
      "#serve": {}
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./fmt": {
        "types": "./dist/fmt.d.mts",
        "default": "./dist/fmt.mjs"
      },
      "./web": {
        "types": "./dist/adapter/web.d.mts",
        "default": "./dist/adapter/web.mjs"
      },
      "./hono": {
        "types": "./dist/adapter/hono.d.mts",
        "default": "./dist/adapter/hono.mjs"
      }
    }
  }
}
