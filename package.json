{
  "type": "module",
  "name": "discord-interactions",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "fmt": "dprint fmt",
    "prepare": "git config core.hooksPath .hooks",
    "api:discord": "deno x npm:openapi-typescript https://raw.githubusercontent.com/discord/discord-api-spec/main/specs/openapi.json --make-paths-enum -o src/lib/discord.oas.ts",
    "serve": "pn serve:bun",
    "serve:bun": "bun --hot ./test/main.ts",
    "serve:deno": "deno -A --env-file --watch-hmr ./test/main.ts",
    "serve:node": "node --import ./src/lib/polyfill.ts --env-file-if-exists .env --watch ./test/main.ts"
  },
  "keywords": [
    "Discord",
    "Discord interactions"
  ],
  "author": "MAKS11060",
  "license": "MIT",
  "packageManager": "pnpm@11.1.3",
  "imports": {
    "#adapter/*": "./src/adapter/*",
    "#lib/*": "./src/lib/*",
    "#/": "./src/*",
    "#app": "./src/mod.ts",
    "#runtime": {
      "bun": "./test/runtime/bun.ts",
      "deno": "./test/runtime/deno.ts",
      "node": "./test/runtime/node.ts",
      "default": "./test/runtime/default.ts"
    }
  },
  "dependencies": {
    "@maks11060/oauth2": "jsr:^0.0.2",
    "@std/bytes": "jsr:^1.0.6",
    "discord-api-types": "^0.38.47",
    "openapi-fetch": "^0.17.0",
    "typescript": "catalog:",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "hono": "catalog:"
  },
  "devDependencies": {
    "@hono/node-server": "^2.0.3",
    "@types/bun": "catalog:",
    "@types/deno": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "tsx": "^4.22.3"
  }
}
