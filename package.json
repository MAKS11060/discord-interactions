{
  "name": "discord-interactions",
  "version": "1.0.0",
  "description": "",
  "keywords": [
    "Discord",
    "Discord interactions"
  ],
  "license": "MIT",
  "author": "MAKS11060",
  "type": "module",
  "imports": {
    "#adapter/*": "./src/adapter/*",
    "#lib/*": "./src/lib/*",
    "#/": "./src/*",
    "#app": "./src/mod.ts",
    "#runtime": {
      "bun": "./test/runtime/bun.ts",
      "deno": "./test/runtime/deno.ts",
      "node": "./test/runtime/node.ts",
      "default": "./test/runtime/default.ts"
    }
  },
  "scripts": {
    "fmt": "dprint fmt",
    "lint": "dprint check && tsc --noEmit",
    "tc": "tsc --noEmit",
    "tcw": "tsc --noEmit --watch",
    "dev": "deno run -A --env-file --watch-hmr ./main.ts",
    "dev:node": "node --env-file-if-exists=.env --watch ./main.ts",
    "prepare": "git config core.hooksPath .hooks",
    "openapi-ts": "openapi-ts"
  },
  "dependencies": {
    "@maks11060/oauth2": "jsr:^0.0.2",
    "@std/bytes": "jsr:^1.0.6",
    "discord-api-types": "^0.38.56",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.0.0-next-20260930190945",
    "@hono/node-server": "^2.1.4",
    "@types/bun": "catalog:",
    "@types/deno": "catalog:",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "hono": "catalog:"
  },
  "packageManager": "pnpm@12.11.2"
}
