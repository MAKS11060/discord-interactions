{
  "deno.enable": false,
  "editor.defaultFormatter": "dprint.dprint",

  "js/ts.experimental.useTsgo": true,

  "explorer.incrementalNaming": "smart",
  "explorer.fileNesting.patterns": {
    "package.json": "deno.*, drizzle.config.*, .*, *.jsonc, *.yaml"
  },

  "nodejs-testing.env": { "FORCE_COLOR": "0" },
  "nodejs-testing.extensions": [{
    // "filePatterns": ["**/*{.test.,.spec.,_test_,_spec_}{js,ts,tsx,jsx,mts,cts,cjs,mjs}"],
    "filePatterns": ["**/*{js,ts,tsx,jsx,mts,cts,cjs,mjs}"],
    "parameters": ["--experimental-transform-types"],
    // "parameters": ["--experimental-transform-types", "--env-file=.env"],
    "extensions": ["ts"]
  }]
}
