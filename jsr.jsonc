{
  "$schema": "https://jsr.io/schema/config-file.v1.json",
  "name": "@maks11060/discord-interactions",
  "version": "0.1.0",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./fmt": "./src/fmt.ts",
    "./web": "./src/adapter/web.ts",
    "./hono": "./src/adapter/hono.ts",
  },
  "publish": {
    "include": [
      "LICENSE",
      "README.md",
      // "src/**/*.ts", // tmp
      "src/*.ts",
      "src/adapter/**/*.ts",
      "src/lib/api/**/*.ts",
      "src/lib/crypto.ts",
    ],
    "exclude": ["src/**/*.test.ts"],
  },
}
